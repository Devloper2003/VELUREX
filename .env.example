# ─────────────────────────────────────────────────────────────────────────────
# Velurex HMS — environment template
#
# Copy the real values into your hosting provider's environment variables
# (Vercel → Project → Settings → Environment Variables) or a local `.env`
# file. NEVER commit the real `.env` — it is git-ignored on purpose.
# ─────────────────────────────────────────────────────────────────────────────

# Neon PostgreSQL — POOLED endpoint (serverless/edge friendly).
# Shape: postgresql://<user>:<password>@<host-pooler>/<db>?sslmode=require
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# Neon PostgreSQL — DIRECT (non-pooler) endpoint, used by Prisma for
# migrations/schema pushes where pgbouncer transaction mode is unsuitable.
DIRECT_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# JWT session signing secret (HS256). Generate with: openssl rand -base64 48
AUTH_SECRET=""

# 64-char hex AES-256-GCM key used for at-rest encryption of sensitive
# platform settings (WhatsApp tokens, API keys). Generate with: openssl rand -hex 32
APP_ENCRYPTION_KEY=""

# ── How to get each value ────────────────────────────────────────────────────
# 1. DATABASE_URL / DIRECT_URL → Neon console → your project → Connection
#    Details → copy the "Pooled connection" string for DATABASE_URL and the
#    direct string for DIRECT_URL.
# 2. AUTH_SECRET / APP_ENCRYPTION_KEY → generate locally, keep them secret
#    and STABLE: rotating APP_ENCRYPTION_KEY makes existing encrypted values
#    unreadable; rotating AUTH_SECRET signs everyone out.
